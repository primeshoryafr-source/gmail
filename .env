# Copy this file to ".env" and fill in the values.
# Keep your real .env PRIVATE - never upload it to GitHub or share it.

# REQUIRED - your bot token (Developer Portal -> your app -> Bot tab)
DISCORD_TOKEN=your_bot_token_here

# OPTIONAL - your server ID. If set, slash commands appear instantly in that server.
# If empty, commands are registered globally (can take up to ~1 hour).
GUILD_ID=
